#!/usr/bin/env bash

set -eo pipefail

green='\033[0;32m'
yellow='\033[0;33m'
red='\033[0;31m'
nc='\033[0m'

script_name=le-autorenew
ssl_root=/etc/nginx/ssl

usage="usage: ${script_name} [web_root] <domain> [domain_2 ...]

Issues a Let's Encrypt certificate for each domain (webroot validation against
<web_root>), installs it into ${ssl_root}/<domain>/ and registers that path with
acme.sh, so every renewal from then on is written there and nginx is reloaded.

A wildcard domain is validated over DNS-01 instead, so it needs no web root, and
is issued together with its apex (a wildcard does not cover it) under the apex's
name. It needs a DNS provider hook in ACME_DNS, plus that provider's credentials
in the environment the first time — acme.sh saves them for renewals. Quote the
wildcard, or the shell will try to expand it.

Set ACME_CHALLENGE_ALIAS to validate through a delegated zone, for a provider
whose API is unusable or too privileged to hand over. Point the challenge at the
alias zone once, by hand, and only that zone is ever written to:

  _acme-challenge.husfokus.com.  CNAME  _acme-challenge.<alias_zone>.

examples:
  ${script_name} /var/www/husfokus/public husfokus.com www.husfokus.com
  CF_Token=... ACME_DNS=dns_cf ${script_name} '*.husfokus.com'
  CF_Token=... ACME_DNS=dns_cf ACME_CHALLENGE_ALIAS=acme.example.net ${script_name} '*.husfokus.com'"

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    echo "$usage"
    exit 0
fi

# a leading '*.' is a domain, never a path, so the web root can simply be left
# out when the first argument is a wildcard
if [[ "$1" == \*.* ]]; then
    web_root=""
    domains=("$@")
else
    web_root="$1"
    domains=("${@:2}")
fi

if [[ ${#domains[@]} -eq 0 ]]; then
    echo -e "${red}[${script_name}] Please supply at least one domain, and a web root for any that is not a wildcard.${nc}"
    echo "$usage"
    exit 1
fi

if [[ -n "$web_root" && ! -d "$web_root" ]]; then
    echo -e "${red}[${script_name}] Web root '${web_root}' does not exist, aborting.${nc}"
    exit 1
fi

# only the wildcards can do without one, so anything else is a missing argument
if [[ -z "$web_root" ]]; then
    for domain in "${domains[@]}"; do
        if [[ "$domain" != \*.* ]]; then
            echo -e "${red}[${script_name}] '${domain}' is validated over HTTP-01 and needs a web root, which was not given.${nc}"
            echo "$usage"
            exit 1
        fi
    done
fi

# acme.sh has to run as the user that owns the account, so this script is run
# unprivileged and only escalates for the writes under /etc/nginx.
if [[ $(id -u) -eq 0 ]]; then
    sudo=""
else
    sudo="sudo"
fi

acme=""
for candidate in \
    "${ACME_SH}" \
    "$(command -v acme.sh || true)" \
    "${HOME}/.acme.sh/acme.sh" \
    "/home/${SUDO_USER:-ifor}/.acme.sh/acme.sh"; do
    if [[ -n "$candidate" && -x "$candidate" ]]; then
        acme="$candidate"
        break
    fi
done

if [[ -z "$acme" ]]; then
    echo -e "${red}[${script_name}] acme.sh not found. Install it or set ACME_SH to its path.${nc}"
    exit 1
fi

# absolute paths throughout: cron has a minimal PATH, and a sudoers NOPASSWD
# rule only matches the fully-qualified command
nginx_bin="$(command -v nginx || true)"
if [[ -z "$nginx_bin" ]]; then
    for candidate in /usr/sbin/nginx /usr/local/sbin/nginx; do
        if [[ -x "$candidate" ]]; then
            nginx_bin="$candidate"
            break
        fi
    done
fi

systemctl_bin="$(command -v systemctl || true)"

if [[ -n "$systemctl_bin" ]]; then
    reload_bin="$systemctl_bin"
    reload_args=(reload nginx)
elif [[ -n "$nginx_bin" ]]; then
    reload_bin="$nginx_bin"
    reload_args=(-s reload)
else
    echo -e "${red}[${script_name}] Neither systemctl nor nginx found, aborting.${nc}"
    exit 1
fi

reload_cmd="${sudo:+sudo }${reload_bin} ${reload_args[*]}"

# where acme.sh keeps its certs, so the store can be checked before installing
acme_home="$(dirname "$acme")"
cert_home="$acme_home"
account_conf="${acme_home}/account.conf"
if [[ -f "$account_conf" ]]; then
    conf_cert_home="$(grep -E "^CERT_HOME=" "$account_conf" | tail -1 | cut -d= -f2- | tr -d "'\"" || true)"
    if [[ -n "$conf_cert_home" ]]; then
        cert_home="$conf_cert_home"
    fi
fi

echo -e "${green}[${script_name}] Using ${acme}${nc}"

# a wildcard can only be validated over DNS-01, so it needs a provider hook.
# acme.sh writes the credentials it was handed into account.conf as SAVED_*,
# which is enough to recognise a provider already used on this box.
dns_hook="${ACME_DNS:-}"

if [[ -z "$dns_hook" && -f "$account_conf" ]]; then
    for pair in CF_Token:dns_cf CF_Key:dns_cf Ali_Key:dns_ali AWS_ACCESS_KEY_ID:dns_aws \
        DP_Id:dns_dp GD_Key:dns_gd DO_API_KEY:dns_dgon NAMESILO_Key:dns_namesilo \
        HE_Username:dns_he LUA_Key:dns_lua; do
        if grep -qE "^SAVED_${pair%%:*}=" "$account_conf"; then
            dns_hook="${pair##*:}"
            echo -e "${green}[${script_name}] Using DNS hook ${dns_hook}, inferred from saved credentials.${nc}"
            break
        fi
    done
fi

# with the challenge delegated by a permanent CNAME, the TXT record is written
# in the alias zone instead, so the hook's credentials never need any power
# over the real zone
challenge_alias="${ACME_CHALLENGE_ALIAS:-}"

if [[ -n "$challenge_alias" ]]; then
    echo -e "${green}[${script_name}] Validating through the alias zone ${challenge_alias}.${nc}"
fi

for domain in "${domains[@]}"; do
    if [[ "$domain" == \*.* && -z "$dns_hook" ]]; then
        echo -e "${red}[${script_name}] '${domain}' needs DNS-01 validation, but no DNS provider hook is set.${nc}"
        echo -e "${red}[${script_name}] Set ACME_DNS to the acme.sh hook and export its credentials once, e.g.:${nc}"
        echo
        echo "  CF_Token=<token> ACME_DNS=dns_cf ${script_name} ${web_root:+${web_root} }'${domain}'"
        echo
        echo "  # every hook and the variables it wants:"
        echo "  ${acme} --dnshelp"
        echo
        echo -e "${red}[${script_name}] acme.sh saves the credentials, so later runs and renewals only need ACME_DNS.${nc}"
        exit 1
    fi
done

installed=()
failed=()

for domain in "${domains[@]}"; do
    # a wildcard does not cover its own apex, and naming the cert after the apex
    # also keeps a '*' out of the install path, so the two are issued together
    if [[ "$domain" == \*.* ]]; then
        cert_name="${domain#*.}"
        issue_args=(-d "$cert_name" -d "$domain" --dns "$dns_hook")
        # quoted, because the hint below is meant to be pasted into a shell
        issue_hint="-d ${cert_name} -d '${domain}' --dns ${dns_hook}"

        if [[ -n "$challenge_alias" ]]; then
            issue_args+=(--challenge-alias "$challenge_alias")
            issue_hint+=" --challenge-alias ${challenge_alias}"
        fi

        echo -e "${green}[${script_name}] Issuing certificate for ${domain} and ${cert_name} over DNS-01...${nc}"
    else
        cert_name="$domain"
        issue_args=(-d "$domain" -w "$web_root")
        issue_hint="${issue_args[*]}"
        echo -e "${green}[${script_name}] Issuing certificate for ${domain}...${nc}"
    fi

    set +e
    "$acme" --issue \
        "${issue_args[@]}" \
        --server letsencrypt \
        --keylength ec-256
    issue_status=$?
    set -e

    # 0 = issued, 2 = a valid cert already exists and acme.sh skipped renewal
    if [[ $issue_status -ne 0 && $issue_status -ne 2 ]]; then
        echo -e "${red}[${script_name}] Issuing failed for ${domain} (exit ${issue_status}), skipping.${nc}"
        failed+=("$domain")
        continue
    fi

    # acme.sh copies these out of its own store, so check they are actually
    # there first: a store missing its key fails inside acme.sh with nothing
    # but a bare "cat: ... No such file or directory"
    store_dir="${cert_home}/${cert_name}_ecc"
    store_key="${store_dir}/${cert_name}.key"
    store_fullchain="${store_dir}/fullchain.cer"
    store_incomplete=""

    [[ -f "$store_key" ]] || store_incomplete+=" ${store_key}"
    [[ -f "$store_fullchain" ]] || store_incomplete+=" ${store_fullchain}"

    if [[ -n "$store_incomplete" ]]; then
        echo -e "${red}[${script_name}] acme.sh's store for ${cert_name} is incomplete, missing:${nc}"
        for missing in $store_incomplete; do
            echo -e "${red}    ${missing}${nc}"
        done
        echo -e "${red}[${script_name}] Nothing can be installed from it. Restore the missing files, or reissue with:${nc}"
        echo -e "${red}    ${acme} --issue ${issue_hint} --server letsencrypt --keylength ec-256 --force${nc}"
        failed+=("$domain")
        continue
    fi

    domain_dir="${ssl_root}/${cert_name}"

    echo -e "${green}[${script_name}] Installing certificate to ${domain_dir}...${nc}"
    $sudo mkdir -p "$domain_dir"
    # owned by the issuing user so unattended renewals can rewrite the files
    $sudo chown "$(id -un):$(id -gn)" "$domain_dir"
    $sudo chmod 750 "$domain_dir"

    # --install-cert both copies the files now and records the destination in
    # acme.sh's config, which is what makes future renewals land here too
    set +e
    "$acme" --install-cert \
        -d "$cert_name" \
        --ecc \
        --key-file "${domain_dir}/privkey.pem" \
        --fullchain-file "${domain_dir}/fullchain.pem" \
        --cert-file "${domain_dir}/cert.pem" \
        --ca-file "${domain_dir}/chain.pem" \
        --reloadcmd "$reload_cmd"
    install_status=$?
    set -e

    # one bad domain must not abort the run, or later domains and the cron job
    # below never get their turn
    if [[ $install_status -ne 0 ]]; then
        echo -e "${red}[${script_name}] Installing failed for ${domain} (exit ${install_status}).${nc}"
        echo -e "${red}[${script_name}] ${domain_dir} may hold a partial copy, check it before pointing nginx at it.${nc}"
        failed+=("$domain")
        continue
    fi

    chmod 640 "${domain_dir}/privkey.pem"
    installed+=("$cert_name")
done

# always, even if every domain failed: renewal being automated is the whole
# point of the script, and it is independent of today's certificates
echo -e "${green}[${script_name}] Ensuring the acme.sh renewal cron job is installed...${nc}"
"$acme" --install-cronjob || true
if crontab -l 2>/dev/null | grep acme; then
    :
else
    echo -e "${yellow}[${script_name}] No acme.sh entry in $(id -un)'s crontab, renewals are NOT automated.${nc}"
fi

if [[ ${#installed[@]} -eq 0 ]]; then
    echo -e "${red}[${script_name}] No certificates were installed.${nc}"
    exit 1
fi

check_passwordless_reload() {
    # -k ignores the password cached earlier in this run, so this tests the
    # sudoers rules themselves — which is what a cron renewal will face.
    # The probe is the real reload: harmless, and the reload is wanted anyway.
    sudo -k -n "$reload_bin" "${reload_args[@]}" >/dev/null 2>&1
}

if [[ -n "$sudo" ]]; then
    echo -e "${green}[${script_name}] Checking that an unattended renewal can reload nginx...${nc}"

    if check_passwordless_reload; then
        echo -e "${green}[${script_name}] Passwordless sudo works, renewals will reload nginx.${nc}"
    else
        sudoers_file="/etc/sudoers.d/${script_name}"
        sudoers_rule="$(id -un) ALL=(root) NOPASSWD: ${reload_bin} ${reload_args[*]}"
        sudoers_tmp="$(mktemp)"

        echo -e "${yellow}[${script_name}] Passwordless sudo failed, so a renewal from cron cannot reload nginx.${nc}"
        echo -e "${yellow}[${script_name}] This can be fixed by granting that one command, and nothing else:${nc}"
        echo
        echo "  ${sudoers_rule}"
        echo
        echo "  # written with:"
        echo "  echo '<rule above>' > ${sudoers_tmp}"
        echo "  sudo visudo -cf ${sudoers_tmp}"
        echo "  sudo install -m 0440 -o root -g root ${sudoers_tmp} ${sudoers_file}"
        echo

        if [[ ! -t 0 ]]; then
            echo -e "${yellow}[${script_name}] Not running interactively, skipping. Run those by hand to fix it.${nc}"
        else
            read -p "Write this sudoers rule? (y/n) " -n 1 -r
            echo

            if [[ $REPLY =~ ^[Yy]$ ]]; then
                if ! sudo grep -qE '^[@#]includedir[[:space:]]+/etc/sudoers\.d' /etc/sudoers; then
                    echo -e "${red}[${script_name}] /etc/sudoers does not include /etc/sudoers.d, the rule would be ignored. Aborting.${nc}"
                else
                    echo "$sudoers_rule" > "$sudoers_tmp"

                    # syntax check before anything lands in /etc/sudoers.d: a
                    # malformed file there breaks sudo for every command
                    if ! sudo visudo -cf "$sudoers_tmp"; then
                        echo -e "${red}[${script_name}] Rule failed visudo's syntax check, nothing was written.${nc}"
                    else
                        sudo install -m 0440 -o root -g root "$sudoers_tmp" "$sudoers_file"
                        echo -e "${green}[${script_name}] Wrote ${sudoers_file}${nc}"

                        if check_passwordless_reload; then
                            echo -e "${green}[${script_name}] Passwordless reload now works.${nc}"
                        else
                            echo -e "${red}[${script_name}] Rule installed but the reload still asks for a password, check ${sudoers_file}.${nc}"
                        fi
                    fi
                fi
            fi
        fi

        rm -f "$sudoers_tmp"
    fi
fi

echo
echo -e "${green}[${script_name}] Installed certificates for: ${installed[*]}${nc}"
echo "Point nginx at them with:"
for domain in "${installed[@]}"; do
    echo
    echo "  # ${domain}"
    echo "  ssl_certificate     ${ssl_root}/${domain}/fullchain.pem;"
    echo "  ssl_certificate_key ${ssl_root}/${domain}/privkey.pem;"
done
echo

if [[ ${#failed[@]} -gt 0 ]]; then
    echo -e "${red}[${script_name}] Failed for: ${failed[*]}${nc}"
    exit 1
fi

echo -e "${green}[${script_name}] All done! Reload nginx once its config points at the new paths.${nc}"
exit 0
