#!/usr/bin/env bash

set -euo pipefail
IFS=$'\n\t'

# cron runs with a bare PATH; aliyun and openssl live in Homebrew.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

log() {
  echo "[$(date '+%F %T')] $*"
}

LOG_FILE="$HOME/Library/Logs/renew-vod-ssl.log"
last_error=""

fail() {
  last_error="$*"
  log "ERROR: $*"
  exit 1
}

# macOS alert. Clicking it opens the cron log.
alert() {
  local title="$1" message="$2"
  log "ALERT: $title: $message"
  if command -v terminal-notifier >/dev/null 2>&1; then
    terminal-notifier -title "$title" -message "$message" \
      -sound Basso -group "renew-vod-ssl-${domain:-}" \
      -open "file://$LOG_FILE" >/dev/null 2>&1 || true
  else
    osascript -e "display notification \"${message//\"/\\\"}\" with title \"${title//\"/\\\"}\" sound name \"Basso\"" >/dev/null 2>&1 || true
  fi
}

# In unattended (--yes) runs, any non-zero exit raises an alert.
on_exit() {
  local rc=$?
  if [[ "$rc" -ne 0 && "${yes:-0}" -eq 1 ]]; then
    alert "SSL renewal failed: ${domain:-unknown domain}" \
      "${last_error:-exited with status $rc}"
  fi
}
trap on_exit EXIT

retry() {
  local n=0
  local max=5
  local delay=5

  until "$@"; do
    n=$((n+1))
    if [ "$n" -ge "$max" ]; then
      return 1
    fi
    log "Retry $n/$max failed: $*"
    sleep $delay
  done
}

# ----------------------------
# Argument parsing
# ----------------------------
force=0     # --force:    re-issue the cert even if it isn't due
yes=0       # --yes:      skip the confirmation prompt (for cron)
redeploy=0  # --redeploy: upload/deploy even if VOD already serves this cert
positional=()

for arg in "$@"; do
  case "$arg" in
    -f|--force) force=1 ;;
    -y|--yes) yes=1 ;;
    --redeploy) redeploy=1 ;;
    *) positional+=("$arg") ;;
  esac
done

set -- ${positional[@]+"${positional[@]}"}

# ----------------------------
# Profile selection
# ----------------------------
profile="${1:-domino}"

if [ "$profile" = "domino" ]; then
  domain="video.dominoedu.com"
  vodId="249878"
  contactId="230"
  aliyunProfile="domino"
  aliyunRegion="cn-hangzhou"
elif [ "$profile" = "exped" ]; then
  domain="video.expednet.cn"
  vodId="7341412"
  contactId="758635"
  aliyunProfile="expednet"
  aliyunRegion="cn-hangzhou"
else
  domain="$1"
  vodId="$2"
  contactId="$3"
  aliyunProfile="$4"
  aliyunRegion="$5"
fi

# VOD domain APIs (used by the direct-attach fallback) live in cn-shanghai.
vodRegion="${VOD_REGION:-cn-shanghai}"

if [ -z "$domain" ]; then
  fail "Usage: $0 [--force] <domain> [VOD Service ID] [Contact ID]"
fi

CONFIG_FILE="$HOME/.aliyun/config.json"

[[ -f "$CONFIG_FILE" ]] || fail "Missing Aliyun config file"

Ali_Key=$(jq -r --arg p "$aliyunProfile" '
.profiles[]
| select(.name == $p)
| .access_key_id
' "$CONFIG_FILE")

Ali_Secret=$(jq -r --arg p "$aliyunProfile" '
.profiles[]
| select(.name == $p)
| .access_key_secret
' "$CONFIG_FILE")

[[ -n "$Ali_Key" && "$Ali_Key" != "null" ]] || fail "Ali_Key not found for profile $aliyunProfile"
[[ -n "$Ali_Secret" && "$Ali_Secret" != "null" ]] || fail "Ali_Secret not found for profile $aliyunProfile"

export Ali_Key Ali_Secret

# ----------------------------
# Dependencies
# ----------------------------
acme="${HOME}/.acme.sh/acme.sh"

command -v "$acme" >/dev/null 2>&1 || fail "Missing acme.sh"
command -v aliyun >/dev/null 2>&1 || fail "Missing aliyun CLI"
command -v jq >/dev/null 2>&1 || fail "Missing jq"

# ----------------------------
# Confirmation
# ----------------------------
echo "----------------------------------------"
echo "SSL Deployment Script - Confirmation"
echo "----------------------------------------"

echo "  Domain         : $domain"
echo "  VOD ID         : $vodId"
echo "  Contact ID     : $contactId"
echo "  Aliyun Profile : $aliyunProfile"
echo "  Region         : $aliyunRegion"
echo "  Force renewal  : $([[ "$force" -eq 1 ]] && echo yes || echo no)"
echo ""

if [[ "$yes" -ne 1 ]]; then
  read -r -p "Proceed? (y/Y): " confirm
  [[ "$confirm" =~ ^[Yy]$ ]] || exit 0
fi

# ----------------------------
# ACME ISSUANCE (with fallback CA)
# ----------------------------

ACME_DIR="${HOME}/.acme.sh/${domain}_ecc"
CERT_FILE="${ACME_DIR}/fullchain.cer"
KEY_FILE="${ACME_DIR}/${domain}.key"

issue_cert() {
  local ca="$1"
  local rc=0
  local force_arg=()

  if [[ "$force" -eq 1 ]]; then
    force_arg=(--force)
  fi

  log "Issuing certificate using CA: $ca"

  "$acme" --issue \
    -d "$domain" \
    --dns dns_ali \
    --server "$ca" \
    ${force_arg[@]+"${force_arg[@]}"} \
    --debug 2 || rc=$?

  # acme.sh exits 2 (RENEW_SKIP) when the existing cert is still valid.
  # That is not a failure: the cert on disk is good and can be redeployed.
  if [[ "$rc" -eq 2 ]]; then
    log "Certificate not due for renewal; reusing existing cert (pass --force to renew anyway)"
  elif [[ "$rc" -ne 0 ]]; then
    return 1
  fi

  [[ -f "$CERT_FILE" ]] || return 1
  [[ -f "$KEY_FILE" ]] || return 1

  return 0
}

log "Starting ACME issuance..."

# Primary CA
if ! issue_cert "letsencrypt"; then
  log "Let’s Encrypt failed, trying ZeroSSL..."

  if ! issue_cert "zerossl"; then
    fail "Both Let’s Encrypt and ZeroSSL failed"
  fi
fi

log "Certificate issued successfully"

# ----------------------------
# Skip if VOD already serves this cert
# ----------------------------
# Lets this run daily from cron: it only uploads/deploys when acme.sh has
# renewed the cert on disk (or a previous deploy failed).
fingerprint() {
  openssl x509 -noout -fingerprint -sha256 2>/dev/null | cut -d= -f2
}

if [[ "$force" -ne 1 && "$redeploy" -ne 1 ]]; then
  localFp=$(fingerprint < "$CERT_FILE")
  liveFp=$(aliyun vod DescribeVodDomainCertificateInfo \
    --profile "$aliyunProfile" \
    --region "$vodRegion" \
    --DomainName "$domain" 2>/dev/null \
    | jq -r '.CertInfos.CertInfo[0].ServerCertificate // empty' \
    | fingerprint || true)

  if [[ -n "$localFp" && "$localFp" == "$liveFp" ]]; then
    log "VOD already serves the current cert ($(openssl x509 -noout -enddate < "$CERT_FILE")); nothing to deploy"

    # acme.sh renews ~30 days before expiry. If the live cert is inside
    # 14 days, the acme.sh cron itself isn't renewing.
    if ! openssl x509 -noout -checkend $((14 * 86400)) < "$CERT_FILE" >/dev/null; then
      fail "cert expires $(openssl x509 -noout -enddate < "$CERT_FILE" | cut -d= -f2) and acme.sh hasn't renewed it"
    fi
    exit 0
  fi

  log "VOD cert differs from the one on disk; deploying"
fi

fullchain="$(cat "$CERT_FILE")"
key="$(cat "$KEY_FILE")"

# ----------------------------
# Upload certificate
# ----------------------------
log "Uploading certificate to Aliyun..."

now=$(date +%Y%m%d%H%M)

output=$(aliyun cas UploadUserCertificate \
  --profile "$aliyunProfile" \
  --region "$aliyunRegion" \
  --Name "${domain}_${now}" \
  --Cert="$fullchain" \
  --Key="$key")

certId=$(echo "$output" | jq -e -r '.CertId') || fail "Missing CertId"

log "New Certificate ID: $certId"

# ----------------------------
# Create deployment job
# ----------------------------
certName="${domain}_${now}"

# Fallback: attach the uploaded CAS cert straight to the VOD domain.
# This skips CAS deployment jobs, which need deployment quota
# (they fail with InsufficientQuota when it runs out).
attach_to_vod_directly() {
  log "Attaching certificate $certId directly to VOD domain $domain..."

  aliyun vod SetVodDomainSSLCertificate \
    --profile "$aliyunProfile" \
    --region "$vodRegion" \
    --DomainName "$domain" \
    --SSLProtocol on \
    --CertType cas \
    --CertId "$certId" \
    --CertName "$certName" \
    --CertRegion "$aliyunRegion" >/dev/null || fail "Direct VOD attach failed too"

  local info
  info=$(aliyun vod DescribeVodDomainCertificateInfo \
    --profile "$aliyunProfile" \
    --region "$vodRegion" \
    --DomainName "$domain")

  local liveId liveExpiry
  liveId=$(echo "$info" | jq -r '.CertInfos.CertInfo[0].CertId')
  liveExpiry=$(echo "$info" | jq -r '.CertInfos.CertInfo[0].CertExpireTime')

  [[ "$liveId" == "$certId" ]] || fail "VOD domain still shows cert $liveId, expected $certId"

  log "VOD domain now uses cert $certId (expires $liveExpiry)"
}

log "Creating deployment job..."

randomJobName=$(openssl rand -hex 4)
jobName="deploy-video-certificate-$randomJobName"

jobId=""
if job=$(aliyun cas CreateDeploymentJob \
  --profile "$aliyunProfile" \
  --region "$aliyunRegion" \
  --JobType user \
  --CertIds "$certId" \
  --Name "$jobName" \
  --ResourceIds "$vodId" \
  --ContactIds "$contactId"); then
  jobId=$(echo "$job" | jq -e -r '.JobId') || jobId=""
fi

if [[ -n "$jobId" ]]; then
  log "Setting job status to pending..."

  if aliyun cas UpdateDeploymentJobStatus \
    --profile "$aliyunProfile" \
    --region "$aliyunRegion" \
    --JobId "$jobId" \
    --Status pending; then
    log "Deployment job created: $jobId"

    echo
    echo "Check status with:"
    echo "aliyun cas --profile $aliyunProfile --region $aliyunRegion DescribeDeploymentJob --JobId $jobId"
    exit 0
  fi

  log "Could not start deployment job $jobId; removing it"
  aliyun cas DeleteDeploymentJob \
    --profile "$aliyunProfile" \
    --region "$aliyunRegion" \
    --JobId "$jobId" >/dev/null || log "Could not delete job $jobId (delete it in the console)"
else
  log "Could not create deployment job"
fi

log "Falling back to direct VOD attach..."
attach_to_vod_directly
