#!/usr/bin/env bash

set -euo pipefail
IFS=$'\n\t'

log() {
  echo "[$(date '+%F %T')] $*"
}

fail() {
  log "ERROR: $*"
  exit 1
}

retry() {
  local n=0
  local max=5
  local delay=5

  until "$@"; do
    n=$((n+1))
    if [ "$n" -ge "$max" ]; then
      return 1
    fi
    log "Retry $n/$max failed: $*"
    sleep $delay
  done
}

# ----------------------------
# Profile selection
# ----------------------------
profile="${1:-domino}"

if [ "$profile" = "domino" ]; then
  domain="video.dominoedu.com"
  vodId="249878"
  contactId="230"
  aliyunProfile="domino"
  aliyunRegion="cn-hangzhou"
elif [ "$profile" = "exped" ]; then
  domain="video.expednet.cn"
  vodId="7341412"
  contactId="758635"
  aliyunProfile="expednet"
  aliyunRegion="cn-hangzhou"
else
  domain="$1"
  vodId="$2"
  contactId="$3"
  aliyunProfile="$4"
  aliyunRegion="$5"
fi

if [ -z "$domain" ]; then
  fail "Usage: $0 <domain> [VOD Service ID] [Contact ID]"
fi

CONFIG_FILE="$HOME/.aliyun/config.json"

[[ -f "$CONFIG_FILE" ]] || fail "Missing Aliyun config file"

Ali_Key=$(jq -r --arg p "$aliyunProfile" '
.profiles[]
| select(.name == $p)
| .access_key_id
' "$CONFIG_FILE")

Ali_Secret=$(jq -r --arg p "$aliyunProfile" '
.profiles[]
| select(.name == $p)
| .access_key_secret
' "$CONFIG_FILE")

[[ -n "$Ali_Key" && "$Ali_Key" != "null" ]] || fail "Ali_Key not found for profile $aliyunProfile"
[[ -n "$Ali_Secret" && "$Ali_Secret" != "null" ]] || fail "Ali_Secret not found for profile $aliyunProfile"

export Ali_Key Ali_Secret

echo $Ali_Secret
echo $Ali_Key

# ----------------------------
# Dependencies
# ----------------------------
acme="${HOME}/.acme.sh/acme.sh"

command -v "$acme" >/dev/null 2>&1 || fail "Missing acme.sh"
command -v aliyun >/dev/null 2>&1 || fail "Missing aliyun CLI"
command -v jq >/dev/null 2>&1 || fail "Missing jq"

# ----------------------------
# Confirmation
# ----------------------------
echo "----------------------------------------"
echo "SSL Deployment Script - Confirmation"
echo "----------------------------------------"

echo "  Domain         : $domain"
echo "  VOD ID         : $vodId"
echo "  Contact ID     : $contactId"
echo "  Aliyun Profile : $aliyunProfile"
echo "  Region         : $aliyunRegion"
echo ""

read -r -p "Proceed? (y/Y): " confirm
[[ "$confirm" =~ ^[Yy]$ ]] || exit 0

# ----------------------------
# ACME ISSUANCE (with fallback CA)
# ----------------------------

ACME_DIR="${HOME}/.acme.sh/${domain}_ecc"
CERT_FILE="${ACME_DIR}/fullchain.cer"
KEY_FILE="${ACME_DIR}/${domain}.key"

issue_cert() {
  local ca="$1"

  log "Issuing certificate using CA: $ca"

  "$acme" --issue \
    -d "$domain" \
    --dns dns_ali \
    --server "$ca" \
    --debug 2 || return 1

  [[ -f "$CERT_FILE" ]] || return 1
  [[ -f "$KEY_FILE" ]] || return 1

  return 0
}

log "Starting ACME issuance..."

# Primary CA
if ! issue_cert "letsencrypt"; then
  log "Let’s Encrypt failed, trying ZeroSSL..."

  if ! issue_cert "zerossl"; then
    fail "Both Let’s Encrypt and ZeroSSL failed"
  fi
fi

log "Certificate issued successfully"

fullchain="$(cat "$CERT_FILE")"
key="$(cat "$KEY_FILE")"

# ----------------------------
# Upload certificate
# ----------------------------
log "Uploading certificate to Aliyun..."

now=$(date +%Y%m%d%H%M)

output=$(aliyun cas UploadUserCertificate \
  --profile "$aliyunProfile" \
  --region "$aliyunRegion" \
  --Name "${domain}_${now}" \
  --Cert="$fullchain" \
  --Key="$key")

certId=$(echo "$output" | jq -e -r '.CertId') || fail "Missing CertId"

log "New Certificate ID: $certId"

# ----------------------------
# Create deployment job
# ----------------------------
log "Creating deployment job..."

randomJobName=$(openssl rand -hex 4)
jobName="deploy-video-certificate-$randomJobName"

job=$(aliyun cas CreateDeploymentJob \
  --profile "$aliyunProfile" \
  --region "$aliyunRegion" \
  --JobType user \
  --CertIds "$certId" \
  --Name "$jobName" \
  --ResourceIds "$vodId" \
  --ContactIds "$contactId")

jobId=$(echo "$job" | jq -e -r '.JobId') || fail "Missing JobId"

log "Setting job status to pending..."

aliyun cas UpdateDeploymentJobStatus \
  --profile "$aliyunProfile" \
  --region "$aliyunRegion" \
  --JobId "$jobId" \
  --Status pending

# ----------------------------
# Final output
# ----------------------------
log "Deployment job created: $jobId"

echo
echo "Check status with:"
echo "aliyun cas --profile $aliyunProfile --region $aliyunRegion DescribeDeploymentJob --JobId $jobId"
