#!/usr/bin/env python3
"""mi-remote — control a Xiaomi Mi TV from the Mac's keyboard.

Uses the TV's local HTTP control API (port 6095) and its DLNA media player
(port 49152). No pairing needed: this machine and the TV just have to be on
the same Wi-Fi. Standard library only.

  mi-remote              # find the TV, then open the keyboard remote
  mi-remote --host IP    # skip discovery
  mi-remote --key home   # send one key and exit
  mi-remote --volume 20  # set the volume and exit
  mi-remote --apps       # list installed apps
  mi-remote --app vlc    # open an app (name or package, partial match ok)
  mi-remote --info       # show what the TV reports about itself
  mi-remote --play FILE  # play a video, song or picture (file or URL) on the TV
  mi-remote --pause      # pause / resume
  mi-remote --stop       # stop playback
"""

import argparse
import concurrent.futures
import json
import os
import socket
import sys
import termios
import time
import tty
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

PORT = 6095
CONFIG = Path.home() / ".config" / "mi-remote" / "config.json"

# key on the Mac -> Mi keycode
KEYMAP = {
    "\x1b[A": "up",
    "\x1b[B": "down",
    "\x1b[C": "right",
    "\x1b[D": "left",
    "\r": "enter",
    "\n": "enter",
    " ": "enter",
    "\x7f": "back",  # backspace
    "b": "back",
    "h": "home",
    "m": "menu",
    "p": "power",
}
VOLUME_KEYS = {"+": "volumeup", "=": "volumeup", "-": "volumedown"}
SOURCES = {"1": "hdmi1", "2": "hdmi2", "3": "hdmi3", "a": "av"}
# one-key app shortcuts: key -> (label, package)
SHORTCUTS = {"n": ("南瓜电影", "com.vcinema.client.tv")}

# (keys, what they do), laid out in as many columns as the terminal width allows
HELP = [
    ("arrows", "move"),
    ("enter", "OK"),
    ("b bksp", "back"),
    ("h", "home"),
    ("m", "menu"),
    ("p", "power off"),
    ("+ -", "volume"),
    ("v", "set volume"),
    ("o", "open app"),
    *[(k, label) for k, (label, _) in SHORTCUTS.items()],
    ("1 2 3 a", "HDMI / AV"),
    ("i", "TV info"),
    ("c", "cast"),
    ("k", "play/pause"),
    ("[ ]", "seek ±30s"),
    ("x", "stop"),
    ("q", "quit"),
]


def text_width(s):
    """Columns a string takes in the terminal (Chinese characters take two)."""
    import unicodedata

    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def pad(s, width):
    return s + " " * max(0, width - text_width(s))


def help_lines(width):
    kw = max(text_width(k) for k, _ in HELP)
    lw = max(text_width(l) for _, l in HELP)
    cell, gap, indent = kw + 1 + lw, 3, 2
    # at most 2 so related keys stay side by side (move/OK, back/home, …)
    cols = max(1, min(2, (width - indent + gap) // (cell + gap)))
    rows = []
    for i in range(0, len(HELP), cols):
        cells = [f"{pad(k, kw)} {pad(l, lw)}" for k, l in HELP[i : i + cols]]
        rows.append(" " * indent + (" " * gap).join(cells).rstrip())
    return rows


class MiTV:
    def __init__(self, host):
        self.host = host

    def _get(self, path, retries=3, **params):
        url = f"http://{self.host}:{PORT}/{path}?{urllib.parse.urlencode(params)}"
        for attempt in range(retries):
            try:
                with urllib.request.urlopen(url, timeout=4) as r:
                    body = r.read().decode(errors="ignore")
                break
            except urllib.error.HTTPError as e:
                # the TV's web server now and then answers 404 to valid requests; retry
                if e.code != 404 or attempt == retries - 1:
                    raise
                time.sleep(0.2)
        try:
            return json.loads(body)
        except ValueError:
            return {"raw": body}

    def info(self):
        return self._get("request", action="isalive").get("data", {})

    def key(self, code):
        return self._get("controller", action="keyevent", keycode=code)

    def source(self, src):
        return self._get("controller", action="changesource", source=src)

    def volume(self):
        d = self._get("controller", action="getvolume").get("data", {})
        return d.get("volume"), d.get("maxVolume")

    def set_volume(self, target):
        """No direct 'set' command exists, so step up/down and read back."""
        vol, mx = self.volume()
        target = max(0, min(int(target), mx or 100))
        for _ in range(3 * (mx or 100)):
            if vol == target:
                break
            self.key("volumeup" if vol < target else "volumedown")
            time.sleep(0.08)
            new, _ = self.volume()
            if new == vol:  # didn't move (e.g. at a limit, or the volume bar was just opening)
                time.sleep(0.25)
                new, _ = self.volume()
            vol = new
        return vol, mx

    def apps(self):
        data = self._get("controller", action="getinstalledapp", count=999, changeIcon=1)
        return [(a["AppName"], a["PackageName"]) for a in data.get("data", {}).get("AppInfo", [])]

    def open_app(self, package):
        return self._get("controller", action="startapp", type="packagename", packagename=package)

    def system_info(self):
        """Everything the TV reports about itself, as (label, value) pairs."""
        sysinfo = self._get("controller", action="getsysteminfo").get("data", {})
        alive = self.info()
        vol, mx = self.volume()
        rows = [
            ("name", sysinfo.get("devicename") or alive.get("devicename")),
            ("address", alive.get("ip")),
            ("platform", sysinfo.get("ptf") or alive.get("platform")),
            ("build", alive.get("build")),
            ("version", alive.get("version")),
            ("code version", sysinfo.get("codever")),
            ("Wi-Fi MAC", sysinfo.get("wifimac")),
            ("Ethernet MAC", sysinfo.get("ethmac")),
            ("device ID", sysinfo.get("deviceid")),
            ("volume", f"{vol}/{mx}" if vol is not None else None),
            ("features", ", ".join(alive.get("feature", [])) or None),
        ]
        return [(k, v) for k, v in rows if v not in (None, "")]


def find_app(apps, query):
    q = query.lower()
    for name, pkg in apps:
        if q in (name.lower(), pkg.lower()):
            return name, pkg
    hits = [(n, p) for n, p in apps if q in n.lower() or q in p.lower()]
    return hits[0] if len(hits) == 1 else None


DLNA_PORT = 49152


class DLNA:
    """The TV's standard UPnP/DLNA media renderer: play a URL, pause, seek, stop.

    (It also has a DLNA volume, but that is the player's own level, not the TV's,
    so volume stays with MiTV.)
    """

    SVC = "urn:schemas-upnp-org:service:AVTransport:1"

    def __init__(self, host):
        self.base = f"http://{host}:{DLNA_PORT}"
        self.control = "/smartshare/render/avt_control"
        try:  # read the real control URL from the device description
            import re

            with urllib.request.urlopen(f"{self.base}/description.xml", timeout=4) as r:
                xml = r.read().decode(errors="ignore")
            m = re.search(r"AVTransport:1</serviceType>.*?<controlURL>([^<]+)", xml, re.S)
            if m:
                self.control = m.group(1)
        except Exception:
            pass

    def _call(self, action, **args):
        import re
        from xml.sax.saxutils import escape, unescape

        body = "".join(f"<{k}>{escape(str(v))}</{k}>" for k, v in args.items())
        envelope = (
            '<?xml version="1.0" encoding="utf-8"?>'
            '<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" '
            's:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"><s:Body>'
            f'<u:{action} xmlns:u="{self.SVC}">{body}</u:{action}>'
            "</s:Body></s:Envelope>"
        )
        req = urllib.request.Request(
            self.base + self.control,
            envelope.encode(),
            {"Content-Type": 'text/xml; charset="utf-8"', "SOAPAction": f'"{self.SVC}#{action}"'},
        )
        try:
            with urllib.request.urlopen(req, timeout=6) as r:
                xml = r.read().decode(errors="ignore")
        except urllib.error.HTTPError as e:
            xml = e.read().decode(errors="ignore")
            m = re.search(r"<errorDescription>([^<]*)", xml) or re.search(r"<faultstring>([^<]*)", xml)
            raise RuntimeError(f"TV refused {action}: {m.group(1) if m else e}") from None
        return {k: unescape(v) for k, v in re.findall(r"<(\w+)>([^<]*)</\1>", xml)}

    def play_url(self, url, title="", mime=None):
        from xml.sax.saxutils import escape

        mime = mime or "video/mp4"
        kind = {"audio": "audioItem.musicTrack", "image": "imageItem.photo"}.get(mime.split("/")[0], "videoItem")
        meta = (
            '<DIDL-Lite xmlns="urn:schemas-upnp-org:metadata-1-0/DIDL-Lite/" '
            'xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:upnp="urn:schemas-upnp-org:metadata-1-0/upnp/">'
            f'<item id="0" parentID="-1" restricted="1"><dc:title>{escape(title or url)}</dc:title>'
            f"<upnp:class>object.item.{kind}</upnp:class>"
            f'<res protocolInfo="http-get:*:{mime}:*">{escape(url)}</res></item></DIDL-Lite>'
        )
        try:
            self._call("SetAVTransportURI", InstanceID=0, CurrentURI=url, CurrentURIMetaData=meta)
        except RuntimeError:  # some renderers choke on metadata; try without
            self._call("SetAVTransportURI", InstanceID=0, CurrentURI=url, CurrentURIMetaData="")
        self._call("Play", InstanceID=0, Speed=1)

    def resume(self):
        self._call("Play", InstanceID=0, Speed=1)

    def pause(self):
        self._call("Pause", InstanceID=0)

    def stop(self):
        self._call("Stop", InstanceID=0)

    def seek(self, seconds):
        s = max(0, int(seconds))
        self._call("Seek", InstanceID=0, Unit="REL_TIME", Target=f"{s // 3600:02}:{s % 3600 // 60:02}:{s % 60:02}")

    def status(self):
        """(state, position s, duration s, uri) — state is PLAYING, PAUSED_PLAYBACK, STOPPED, …"""
        state = self._call("GetTransportInfo", InstanceID=0).get("CurrentTransportState", "?")
        pos = self._call("GetPositionInfo", InstanceID=0)
        return state, hms_to_s(pos.get("RelTime")), hms_to_s(pos.get("TrackDuration")), pos.get("TrackURI", "")

    def active(self):
        """Position info if something is loaded, else raise NothingPlaying (the TV refuses seek/pause then)."""
        st = self.status()
        if st[0] not in ("PLAYING", "PAUSED_PLAYBACK"):
            raise NothingPlaying("nothing is playing")
        return st

    def toggle(self):
        state = self.active()[0]
        if state == "PLAYING":
            self.pause()
            return "paused"
        self.resume()
        return "playing"

    def seek_by(self, delta):
        _, pos, dur, _ = self.active()
        target = pos + delta
        target = max(0, min(target, dur - 1)) if dur else max(0, target)
        # The TV accepts a seek but sometimes (often early in a file) its player
        # snaps back to where it was a second later. Check, and seek again if so.
        for _ in range(3):
            self.seek(target)
            time.sleep(1.5)
            now = self.status()[1]
            if abs(now - target) <= 5:
                break
        return target


class NothingPlaying(RuntimeError):
    pass


def hms_to_s(t):
    try:
        h, m, s = (t or "").split(":")
        return int(h) * 3600 + int(m) * 60 + int(float(s))
    except ValueError:
        return 0


def s_to_hms(s):
    return f"{s // 3600}:{s % 3600 // 60:02}:{s % 60:02}" if s >= 3600 else f"{s // 60}:{s % 60:02}"


class MediaServer:
    """Serves one local file over HTTP, with Range support so the TV can seek."""

    def __init__(self, path, bind_ip):
        import mimetypes
        import threading
        from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

        self.path = Path(path)
        self.size = self.path.stat().st_size
        self.mime = mimetypes.guess_type(self.path.name)[0] or "video/mp4"
        self.mime = {"video/x-matroska": "video/x-mkv"}.get(self.mime, self.mime)
        server = self

        class Handler(BaseHTTPRequestHandler):
            def log_message(self, *a):
                pass

            def _headers(self):
                start, end = 0, server.size - 1
                rng = self.headers.get("Range", "")
                if rng.startswith("bytes="):
                    a, _, b = rng[6:].split(",")[0].partition("-")
                    if a:
                        start, end = int(a), int(b) if b else end
                    elif b:  # last N bytes
                        start = max(0, server.size - int(b))
                    end = min(end, server.size - 1)
                    self.send_response(206)
                    self.send_header("Content-Range", f"bytes {start}-{end}/{server.size}")
                else:
                    self.send_response(200)
                self.send_header("Content-Type", server.mime)
                self.send_header("Content-Length", str(end - start + 1))
                self.send_header("Accept-Ranges", "bytes")
                self.send_header("transferMode.dlna.org", "Streaming")
                self.send_header("contentFeatures.dlna.org", "DLNA.ORG_OP=01;DLNA.ORG_CI=0;DLNA.ORG_FLAGS=01700000000000000000000000000000")
                self.end_headers()
                return start, end

            def do_HEAD(self):
                self._headers()

            def do_GET(self):
                start, end = self._headers()
                try:
                    with open(server.path, "rb") as f:
                        f.seek(start)
                        left = end - start + 1
                        while left > 0:
                            chunk = f.read(min(256 * 1024, left))
                            if not chunk:
                                break
                            self.wfile.write(chunk)
                            left -= len(chunk)
                except (BrokenPipeError, ConnectionResetError):
                    pass  # the TV closes connections when it seeks

        self.httpd = ThreadingHTTPServer((bind_ip, 0), Handler)
        self.httpd.daemon_threads = True
        ip, port = self.httpd.server_address[:2]
        self.url = f"http://{ip}:{port}/{urllib.parse.quote(self.path.name)}"
        threading.Thread(target=self.httpd.serve_forever, daemon=True).start()

    def close(self):
        self.httpd.shutdown()
        self.httpd.server_close()


def clean_path(s):
    """Accept paths pasted or dragged in with quotes or backslash-escaped spaces."""
    s = s.strip()
    if len(s) >= 2 and s[0] == s[-1] and s[0] in "'\"":
        s = s[1:-1]
    return os.path.expanduser(s.replace("\\ ", " "))


# The TV's DLNA player stalls forever on Matroska files ("retrieving content information"),
# but plays the same video fine in an mp4, so these get repackaged first.
REPACKAGE = {".mkv", ".webm"}
CACHE = Path.home() / ".cache" / "mi-remote"


def prepare_for_tv(path, say=print):
    """Return a path the TV can play: the file itself, or an mp4 copy made with ffmpeg."""
    import hashlib
    import shutil
    import subprocess

    if path.suffix.lower() not in REPACKAGE:
        return path
    if not shutil.which("ffmpeg"):
        raise RuntimeError(f"the TV can't play {path.suffix} files; install ffmpeg so they can be converted to mp4")
    st = path.stat()
    key = hashlib.sha1(f"{path.resolve()}|{st.st_size}|{st.st_mtime}".encode()).hexdigest()[:12]
    out = CACHE / f"{path.stem}.{key}.mp4"
    if out.exists():
        return out
    CACHE.mkdir(parents=True, exist_ok=True)
    for old in sorted(CACHE.glob("*.mp4"), key=lambda p: p.stat().st_mtime)[:-2]:
        old.unlink(missing_ok=True)  # keep only the most recent couple of conversions

    def ffmpeg(audio):
        tmp = out.with_suffix(".part")
        cmd = ["ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-i", str(path),
               "-map", "0:v:0", "-map", "0:a:0?", "-c:v", "copy", *audio,
               "-movflags", "+faststart", "-f", "mp4", str(tmp)]
        r = subprocess.run(cmd, capture_output=True, text=True)
        if r.returncode == 0:
            tmp.rename(out)
            return True
        tmp.unlink(missing_ok=True)
        return r.stderr.strip().splitlines()[-1:] or ["ffmpeg failed"]

    say(f"converting {path.name} to mp4 for the TV…")
    # copy the picture and sound as they are (seconds); if the sound format
    # isn't allowed in mp4 (e.g. Vorbis/Opus/DTS), re-encode just the sound to AAC
    if ffmpeg(["-c:a", "copy"]) is True:
        return out
    say(f"converting {path.name}: re-encoding the sound (this can take a minute)…")
    err = ffmpeg(["-c:a", "aac", "-b:a", "192k"])
    if err is True:
        return out
    raise RuntimeError(f"couldn't convert {path.name}: {err[0]}")


def start_cast(dlna, tv_host, source, say=print):
    """Play a URL or a local file on the TV. Returns (title, server or None)."""
    import mimetypes

    if source.startswith(("http://", "https://")):
        title = urllib.parse.unquote(source.rsplit("/", 1)[-1].split("?")[0]) or source
        dlna.play_url(source, title, mimetypes.guess_type(source.split("?")[0])[0])
        return title, None
    original = Path(clean_path(source))
    if not original.is_file():
        raise RuntimeError(f"no such file: {original}")
    bind_ip = route_ip(tv_host)
    if not bind_ip:
        raise RuntimeError("can't tell which network the TV is on")
    path = prepare_for_tv(original, say)
    srv = MediaServer(path, bind_ip)
    try:
        dlna.play_url(srv.url, original.name, srv.mime)
    except Exception:
        srv.close()
        raise
    return original.name, srv


def load_config():
    return json.loads(CONFIG.read_text()) if CONFIG.exists() else {}


def is_mi(ip):
    try:
        data = MiTV(ip).info()
        return data.get("devicename") or "Mi TV"
    except Exception:
        return None


def route_ip(dest):
    """The local address the OS would use to reach `dest` (UDP connect sends nothing)."""
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect((dest, 80))
        return s.getsockname()[0]
    except OSError:
        return None
    finally:
        s.close()


def local_ips():
    """Candidate addresses of this machine on the home network, best first."""
    import shutil
    import subprocess

    ips = []
    # macOS: ask for the Wi-Fi/Ethernet address directly; with a VPN on,
    # the default route points at the VPN instead.
    if shutil.which("ipconfig") and sys.platform == "darwin":
        for iface in ("en0", "en1", "en2"):
            ip = subprocess.run(["ipconfig", "getifaddr", iface], capture_output=True, text=True).stdout.strip()
            if ip:
                ips.append(ip)
    # Everywhere else (Linux, Termux on Android): the route towards common home-router
    # ranges picks the Wi-Fi interface, then fall back to the default route.
    for dest in ("192.168.1.1", "192.168.0.1", "10.0.0.1", "8.8.8.8"):
        ip = route_ip(dest)
        if ip and not ip.startswith("127."):
            ips.append(ip)
    return list(dict.fromkeys(ips))


def scan_subnet(extra_hosts=()):
    bases = [ip.rsplit(".", 1)[0] for ip in [*extra_hosts, *local_ips()]]
    bases = list(dict.fromkeys(bases))
    if not bases:
        return []

    def probe(ip):
        try:
            socket.create_connection((ip, PORT), timeout=0.6).close()
        except OSError:
            return None
        name = is_mi(ip)
        return (name, ip) if name else None

    for base in bases:
        with concurrent.futures.ThreadPoolExecutor(128) as ex:
            found = [h for h in ex.map(probe, [f"{base}.{i}" for i in range(1, 255)]) if h]
        if found:
            return found
    return []


def pick_host(args, cfg):
    if args.host:
        return args.host
    if cfg.get("host") and is_mi(cfg["host"]):
        return cfg["host"]
    print("Looking for your Mi TV on the network…")
    # the TV's last known address may have changed, but its subnet probably hasn't
    found = scan_subnet([cfg["host"]] if cfg.get("host") else [])
    if not found:
        sys.exit("Nothing found. Is the TV on and on the same Wi-Fi? Or pass --host <ip>.")
    if len(found) == 1:
        return found[0][1]
    for i, (name, ip) in enumerate(found, 1):
        print(f"  {i}. {name}  {ip}")
    return found[int(input("Which one? ")) - 1][1]


def read_key():
    ch = os.read(sys.stdin.fileno(), 1).decode(errors="ignore")
    if ch == "\x1b":
        ch += os.read(sys.stdin.fileno(), 2).decode(errors="ignore")
    return ch


# Full-screen UI: drawn on the terminal's alternate screen and redrawn in place,
# so key presses don't pile up and the terminal is left as it was on quit.
ALT_ON, ALT_OFF = "\x1b[?1049h", "\x1b[?1049l"
CUR_HIDE, CUR_SHOW = "\x1b[?25l", "\x1b[?25h"
HOME_CLEAR = "\x1b[H\x1b[2J"
BOLD, DIM, GREEN, RED, RESET = "\x1b[1m", "\x1b[2m", "\x1b[32m", "\x1b[31m", "\x1b[0m"

KEY_LABELS = {
    "up": "↑ up", "down": "↓ down", "left": "← left", "right": "→ right",
    "enter": "OK", "back": "back", "home": "home", "menu": "menu", "power": "power",
    "volumeup": "volume +", "volumedown": "volume −",
}


def out(s):
    sys.stdout.write(s)
    sys.stdout.flush()


def volume_text(vol, mx, width):
    if vol is None:
        return "volume  ?"
    bar = max(5, min(25, width - 20))  # "  volume  18/50  " takes ~17 columns
    filled = round(bar * vol / (mx or 100))
    return f"volume {vol:>3}/{mx}  {GREEN}{'█' * filled}{DIM}{'░' * (bar - filled)}{RESET}"


def playing_text(play, width):
    """'▶ title  1:23 / 45:00' for the now-playing line."""
    state, pos, dur, title = play
    icon = {"PLAYING": "▶", "PAUSED_PLAYBACK": "❚❚", "TRANSITIONING": "…"}.get(state, "■")
    times = f"{s_to_hms(pos)} / {s_to_hms(dur)}" if dur else s_to_hms(pos)
    room = max(5, width - len(times) - 9)
    title = title if len(title) <= room else title[: room - 1] + "…"
    return f"{GREEN}{icon}{RESET} {title}  {DIM}{times}{RESET}"


class Screen:
    def __init__(self, tv, name, host):
        self.tv = tv
        self.name, self.host = name, host
        self.last = ""
        self.body = None
        self.play = None  # (state, pos, dur, title) while something is cast
        self.refresh_volume()

    def draw(self, body=None):
        """Header, help, [now playing], volume, blank line, last action; `body` replaces the last for menus."""
        import shutil

        self.body = body
        width = shutil.get_terminal_size().columns
        title = f"{self.name}  ·  {self.host}"
        lines = [f"  {BOLD}{title}{RESET}"] if len(title) + 2 <= width else [f"  {BOLD}{self.name}{RESET}", f"  {self.host}"]
        lines.append("")
        lines += [f"{DIM}{l}{RESET}" for l in help_lines(width)]
        lines.append("")
        if self.play:
            lines.append(f"  {playing_text(self.play, width)}")
        lines += [f"  {volume_text(*self.vol, width)}", ""]
        lines += body if body is not None else [f"  {self.last}"]
        # overwrite in place (clear each line's tail, then everything below) — no flicker
        out("\x1b[H" + "\r\n".join(l + "\x1b[K" for l in lines) + "\x1b[J")

    def refresh_volume(self):
        self.vol = self.tv.volume()


def interactive(tv, name, host):
    import signal

    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    scr = Screen(tv, name, host)
    # redraw to fit when the window (or phone screen) is resized or rotated
    signal.signal(signal.SIGWINCH, lambda *_: scr.draw(scr.body))

    def ask(body, prompt):
        scr.draw(body + ["", f"  {prompt}"])
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        out(CUR_SHOW)
        try:
            return input().strip()
        finally:
            out(CUR_HIDE)
            tty.setcbreak(fd)

    import select

    dlna = DLNA(host)
    cast = {"title": None, "server": None, "started": 0.0}

    def stop_serving():
        if cast["server"]:
            cast["server"].close()
        cast.update(title=None, server=None, started=0.0)

    def say(msg):
        scr.last = msg
        scr.draw()

    def poll():
        """Update the now-playing line from the TV's media player."""
        try:
            state, pos, dur, uri = dlna.status()
        except Exception:
            return
        if state in ("PLAYING", "PAUSED_PLAYBACK", "TRANSITIONING"):
            title = cast["title"] or urllib.parse.unquote(uri.rsplit("/", 1)[-1].split("?")[0]) or "media"
            scr.play = (state, pos, dur, title)
            if state == "TRANSITIONING" and cast["started"] and time.time() - cast["started"] > 20:
                scr.last = f"{RED}the TV is stuck loading this — it may not support the file (x to stop){RESET}"
        else:
            scr.play = None

    out(ALT_ON + CUR_HIDE)
    try:
        tty.setcbreak(fd)
        poll()
        scr.draw()
        while True:
            # while something plays, refresh its progress every second; otherwise check now and then
            ready, _, _ = select.select([fd], [], [], 1.0 if scr.play else 5.0)
            if not ready:
                before = scr.play
                poll()
                if scr.play != before:
                    scr.draw(scr.body)
                continue
            k = read_key()
            if k in ("q", "\x03"):
                break
            try:
                if k == "c":
                    src = ask([], "file or URL to cast (Enter to cancel): ")
                    if src:
                        say("starting…")
                        stop_serving()
                        title, srv = start_cast(dlna, host, src, say)
                        cast.update(title=title, server=srv, started=time.time())
                        scr.last = f"casting {title}"
                        time.sleep(1)
                        poll()
                elif k == "k":
                    scr.last = dlna.toggle()
                    time.sleep(0.3)
                    poll()
                elif k == "x":
                    try:
                        dlna.stop()
                    except RuntimeError:
                        pass  # already stopped
                    stop_serving()
                    scr.play = None
                    scr.last = "stopped"
                elif k in ("[", "]"):
                    say("seeking…")
                    target = dlna.seek_by(30 if k == "]" else -30)
                    scr.last = f"seek → {s_to_hms(target)}"
                    time.sleep(0.3)
                    poll()
                elif k in SOURCES:
                    tv.source(SOURCES[k])
                    scr.last = f"input → {SOURCES[k]}"
                elif k in VOLUME_KEYS:
                    tv.key(VOLUME_KEYS[k])
                    scr.last = KEY_LABELS[VOLUME_KEYS[k]]
                    time.sleep(0.1)
                    scr.refresh_volume()
                elif k == "v":
                    _, mx = tv.volume()
                    n = ask([], f"set volume to (0-{mx}), Enter to cancel: ")
                    if n.isdigit():
                        scr.last = "setting volume…"
                        scr.draw()
                        tv.set_volume(int(n))
                        scr.refresh_volume()
                        scr.last = f"volume → {n}"
                elif k == "o":
                    apps = tv.apps()
                    menu = [f"  {i:>2}. {name}" for i, (name, _) in enumerate(apps, 1)]
                    n = ask(menu, "open which? (number, Enter to cancel): ")
                    if n.isdigit() and 1 <= int(n) <= len(apps):
                        name, pkg = apps[int(n) - 1]
                        r = tv.open_app(pkg)
                        scr.last = f"opening {name}" if r.get("msg") == "success" else f"{RED}TV said: {r}{RESET}"
                elif k in SHORTCUTS:
                    label, pkg = SHORTCUTS[k]
                    r = tv.open_app(pkg)
                    scr.last = f"opening {label}" if r.get("msg") == "success" else f"{RED}TV said: {r}{RESET}"
                elif k == "i":
                    import shutil

                    rows = tv.system_info()
                    w = max(len(label) for label, _ in rows)
                    room = max(8, shutil.get_terminal_size().columns - w - 4)

                    def fit(v):
                        v = str(v)
                        return v if len(v) <= room else v[: room - 1] + "…"

                    scr.refresh_volume()
                    # shown until the next key press
                    scr.draw([f"  {DIM}{label:<{w}}{RESET}  {fit(value)}" for label, value in rows])
                    continue
                elif k in KEYMAP:
                    tv.key(KEYMAP[k])
                    scr.last = KEY_LABELS.get(KEYMAP[k], KEYMAP[k])
                else:
                    continue
            except NothingPlaying as e:
                scr.last = str(e)
            except Exception as e:
                scr.last = f"{RED}error: {e}{RESET}"
            scr.draw()
    finally:
        if cast["server"]:
            # the file is served from this machine, so playback can't outlive the remote
            try:
                dlna.stop()
            except Exception:
                pass
            stop_serving()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        out(CUR_SHOW + ALT_OFF)


def play_cli(dlna, host, source):
    title, srv = start_cast(dlna, host, source)
    if not srv:
        print(f"playing {title}")
        return
    # a local file: keep serving it, showing progress, until it ends or Ctrl-C
    print(f"playing {title} from this machine — Ctrl-C stops it")
    started, seen_playing = time.time(), False
    try:
        while True:
            time.sleep(1)
            try:
                state, pos, dur, _ = dlna.status()
            except Exception:
                continue
            if state in ("PLAYING", "PAUSED_PLAYBACK"):
                seen_playing = True
                sys.stdout.write(f"\r\x1b[2K{playing_text((state, pos, dur, title), 80)}")
                sys.stdout.flush()
            elif state == "STOPPED" and (seen_playing or time.time() - started > 30):
                print("\nfinished")
                break
    except KeyboardInterrupt:
        try:
            dlna.stop()
        except Exception:
            pass
        print("\nstopped")
    finally:
        srv.close()


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--host", help="TV IP address")
    ap.add_argument("--key", help="send one key (up, down, left, right, enter, back, home, menu, volumeup, volumedown, power) and exit")
    ap.add_argument("--volume", type=int, help="set the volume to this level and exit")
    ap.add_argument("--apps", action="store_true", help="list installed apps and exit")
    ap.add_argument("--app", help="open an app by name or package and exit")
    ap.add_argument("--info", action="store_true", help="show what the TV reports about itself and exit")
    ap.add_argument("--play", metavar="FILE_OR_URL", help="play a video, song or picture on the TV (a local file is served from here until it ends or Ctrl-C)")
    ap.add_argument("--pause", action="store_true", help="pause / resume what's playing and exit")
    ap.add_argument("--stop", action="store_true", help="stop what's playing and exit")
    args = ap.parse_args()

    cfg = load_config()
    host = pick_host(args, cfg)
    tv = MiTV(host)
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(json.dumps({**cfg, "host": host}, indent=2))

    if args.key:
        print(tv.key(args.key))
    elif args.volume is not None:
        vol, mx = tv.set_volume(args.volume)
        print(f"volume {vol}/{mx}")
    elif args.play:
        play_cli(DLNA(host), host, args.play)
    elif args.pause:
        try:
            print(DLNA(host).toggle())
        except NothingPlaying as e:
            sys.exit(str(e))
    elif args.stop:
        try:
            DLNA(host).stop()
        except RuntimeError:
            pass  # already stopped
        print("stopped")
    elif args.info:
        rows = tv.system_info()
        w = max(len(label) for label, _ in rows)
        for label, value in rows:
            print(f"{label:<{w}}  {value}")
    elif args.apps:
        for name, pkg in tv.apps():
            print(f"{name}  ({pkg})")
    elif args.app:
        hit = find_app(tv.apps(), args.app)
        if not hit:
            sys.exit(f"No single app matches '{args.app}'. Try --apps.")
        r = tv.open_app(hit[1])
        print(f"opening {hit[0]}" if r.get("msg") == "success" else f"TV said: {r}")
    else:
        interactive(tv, tv.info().get("devicename", "Mi TV"), host)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
