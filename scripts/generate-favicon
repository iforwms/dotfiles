#!/usr/bin/env bash

set -eo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'
# REPLACE='\e[1A\e[K' # To go N lines up: \e[<N>A (\e[K clears the line)

script_name=generate-favicon
usage="usage: ${script_name} <image_path> [output_path] [url_path] [app_name]"

# The realfavicongenerator.net REST API has been retired, its official CLI generates everything locally
realfavicon_cli=realfavicon@0.9.3
icon_path="$1"
output_path="${2:-${HOME}/Downloads/favicon-temp}"
url_path="${3:-/}" # URL prefix the files are served from, e.g. /static
app_name="$4"

if ! [[ -e "$icon_path" ]]; then
  echo -e "${RED}[${script_name}] Image not found, aborting...${NC}"
  echo -e "${YELLOW}${usage}${NC}"
  exit 1
fi

if ! command -v npx > /dev/null; then
  echo -e "${RED}[${script_name}] npx not found, install Node.js first...${NC}"
  exit 1
fi

if ! [[ -e "$output_path" ]]; then
  echo -e "${YELLOW}[${script_name}] Output path not found, creating...${NC}"
  mkdir -p "$output_path"
fi

# The CLI concatenates this with the file names as is, so it needs leading and trailing slashes
[[ "$url_path" == /* ]] || url_path="/${url_path}"
[[ "$url_path" == */ ]] || url_path="${url_path}/"

if [[ -z "$app_name" ]]; then
  app_name="$(basename "$(git -C "$output_path" rev-parse --show-toplevel 2> /dev/null || realpath "$output_path")")"
fi

tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

# The CLI's SVG parser crashes on xml:* attributes (e.g. xml:space="preserve"), which are safe to drop
if [[ "$icon_path" == *.svg ]]; then
  sed -E 's/[[:space:]]xml:[a-z]+="[^"]*"//g' "$icon_path" > "${tmp_dir}/icon.svg"
  icon_path="${tmp_dir}/icon.svg"
fi

echo -e "${GREEN}[${script_name}] Writing settings (app name: ${app_name}, URL path: ${url_path})...${NC}"
jq --null-input --arg path "$url_path" --arg name "$app_name" '
  def transformation($type; $radius): {
    type: $type,
    backgroundColor: "#ffffff",
    backgroundRadius: $radius,
    imageScale: 0.7,
    brightness: 1
  };
  {
    icon: {
      desktop: {
        regularIconTransformation: transformation("none"; 0.7),
        darkIconType: "none",
        darkIconTransformation: transformation("none"; 0.7)
      },
      touch: {
        transformation: transformation("background"; 0),
        appTitle: $name
      },
      webAppManifest: {
        transformation: transformation("background"; 0),
        name: $name,
        shortName: $name,
        backgroundColor: "#ffffff",
        themeColor: "#ffffff"
      }
    },
    path: $path
  }' > "${tmp_dir}/settings.json"

echo -e "${GREEN}[${script_name}] Generating favicon files...${NC}"
npx --yes "$realfavicon_cli" generate \
  "$icon_path" \
  "${tmp_dir}/settings.json" \
  "${tmp_dir}/markups.json" \
  "$output_path"

echo -e "${GREEN}[${script_name}] All done! Files written to ${output_path}${NC}"

echo 'Add the following to your page head
'
jq --raw-output '.markups[]' "${tmp_dir}/markups.json"

exit 0
